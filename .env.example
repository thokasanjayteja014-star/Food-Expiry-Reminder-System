# Copy to .env.local and fill in. Never commit real values.

# --- Firebase web app (Project settings > General > Your apps > Web app) ---
# These are public identifiers; Firestore security rules protect the data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only; Project settings > Service accounts > Generate new private key) ---
# SECRET. Paste the private key on one line with \n for line breaks, wrapped in double quotes.
FIREBASE_ADMIN_PROJECT_ID=your-project
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Web Push (VAPID). Generate with: npm run vapid ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# SECRET
VAPID_PRIVATE_KEY=
# Contact for push services: a mailto: or https: URL you control.
VAPID_SUBJECT=mailto:you@example.com

# --- Reminder scheduler ---
# SECRET. Random string; the scheduler sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Optional ---
# Set to "false" to hide demo mode in production.
NEXT_PUBLIC_ENABLE_DEMO=true
# OCR files are self-hosted from /ocr by default. Override to load language data elsewhere.
NEXT_PUBLIC_TESSERACT_LANG_PATH=

# AI reading of expiry dates. Set one or more keys; they are tried in this order and a busy
# one falls through to the next. Without any, scans use only the offline reader.
# Groq (free, no card): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=
# Grok from xAI (paid credits): https://console.x.ai
XAI_API_KEY=
XAI_MODEL=
# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: which Gemini model to use (default gemini-3.8-flash; a retired model is replaced automatically).
GEMINI_MODEL=
