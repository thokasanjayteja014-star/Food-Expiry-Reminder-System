rules_version = '2';

// Each user can only read and write documents under their own users/{uid} path.
// A household's shared food list (households/{id}/products) is open to its members only.
// Households, invites, memberships and push subscriptions are written only by the server
// (the Admin SDK bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isTimestampOrNull(v) {
      return v == null || v is timestamp;
    }

    // Signed in and listed in the household's members.
    function isMember(householdId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    // householdId may be present (set by the server) but a user can never change it.
    function householdUnchanged() {
      return request.resource.data.get('householdId', null) == resource.data.get('householdId', null);
    }

    function validProfile(d) {
      return d.keys().hasOnly(['name', 'email', 'defaultReminderDays', 'timeZone', 'notificationsEnabled', 'emailReminders', 'householdId', 'createdAt', 'updatedAt'])
        && (!('name' in d) || (d.name is string && d.name.size() <= 60))
        && (!('email' in d) || d.email is string)
        && (!('defaultReminderDays' in d) || (d.defaultReminderDays is int && d.defaultReminderDays >= 1 && d.defaultReminderDays <= 30))
        && (!('timeZone' in d) || (d.timeZone is string && d.timeZone.size() < 64))
        && (!('notificationsEnabled' in d) || d.notificationsEnabled is bool)
        && (!('emailReminders' in d) || d.emailReminders is bool);
    }

    function validProduct(d) {
      return d.keys().hasOnly([
          'productName', 'category', 'manufacturingDate', 'expiryDate', 'expiryDateSource', 'quantity',
          'storageLocation', 'notes', 'imageUrl', 'source', 'reminderDays', 'status',
          'consumedAt', 'discardedAt', 'addedBy', 'addedByName', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['productName', 'category', 'expiryDate', 'reminderDays', 'status', 'source'])
        && d.productName is string && d.productName.size() > 0 && d.productName.size() <= 80
        && d.category in ['Dairy', 'Bakery', 'Snacks', 'Beverages', 'Frozen', 'Canned', 'Sauces', 'Fruits', 'Vegetables', 'Other']
        && isDate(d.expiryDate)
        && (d.get('manufacturingDate', null) == null || isDate(d.manufacturingDate))
        && d.get('expiryDateSource', 'manual') in ['printed', 'calculated', 'manual']
        && (d.get('quantity', null) == null || (d.quantity is number && d.quantity > 0))
        && d.get('storageLocation', '') is string && d.get('storageLocation', '').size() <= 60
        && d.get('notes', '') is string && d.get('notes', '').size() <= 500
        && (d.get('imageUrl', null) == null
            || (d.imageUrl is string && d.imageUrl.size() < 150000 && d.imageUrl.matches('data:image/jpeg;base64,.*')))
        && d.source in ['ocr', 'manual', 'demo']
        && d.reminderDays is int && d.reminderDays >= 1 && d.reminderDays <= 30
        && d.status in ['ACTIVE', 'CONSUMED', 'DISCARDED']
        && isTimestampOrNull(d.get('consumedAt', null))
        && isTimestampOrNull(d.get('discardedAt', null))
        && (d.get('addedByName', null) == null || (d.addedByName is string && d.addedByName.size() <= 60));
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validProfile(request.resource.data) && !('householdId' in request.resource.data);
      allow update: if isOwner(userId) && validProfile(request.resource.data) && householdUnchanged();
      allow delete: if false;

      match /products/{productId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && validProduct(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(userId)
          && validProduct(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
      }

      match /notifications/{notificationId} {
        allow read, delete: if isOwner(userId);
        // The in-app reminder check may record reminders; it cannot claim a push was sent.
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['title', 'message', 'productId', 'type', 'scheduledFor', 'sentAt', 'pushStatus', 'read', 'createdAt'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 100
          && request.resource.data.message is string && request.resource.data.message.size() <= 300
          && request.resource.data.type in ['EXPIRING_SOON', 'EXPIRING_TODAY', 'EXPIRED', 'TEST']
          && request.resource.data.pushStatus in ['local', 'not_attempted']
          && request.resource.data.sentAt == null
          && request.resource.data.read == false;
        // Users can only change the read flag.
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
      }

      match /pushSubscriptions/{subscriptionId} {
        allow read, write: if false;
      }
    }

    // Members can see their household (name, members, invite code); only the server changes it.
    match /households/{householdId} {
      allow read: if isMember(householdId);
      allow write: if false;

      match /products/{productId} {
        allow read, delete: if isMember(householdId);
        allow create: if isMember(householdId)
          && validProduct(request.resource.data)
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isMember(householdId)
          && validProduct(request.resource.data)
          && request.resource.data.get('addedBy', null) == resource.data.get('addedBy', null)
          && request.resource.data.get('addedByName', null) == resource.data.get('addedByName', null)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
      }
    }

    // Invite codes are looked up by the server only, so codes cannot be listed or guessed in bulk.
    match /householdInvites/{code} {
      allow read, write: if false;
    }
  }
}
